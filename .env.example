# Database (Prisma, PostgreSQL)
DATABASE_URL=
DIRECT_URL=

# Supabase Auth + Realtime (project settings -> API)
# Publishable/anon key aman untuk browser (prefix NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# HANYA untuk skrip bootstrap admin: scripts/bootstrap-auth-users.ts
# Jangan pernah di-prefix NEXT_PUBLIC_ dan jangan pernah dipakai di kode browser.
SUPABASE_SERVICE_ROLE_KEY=

# Sandi bootstrap akun Auth, dibaca skrip di atas (opsional, development saja).
